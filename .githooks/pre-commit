#!/usr/bin/env bash
# Pre-commit hook: block staged content that looks like an API key or private key.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

patterns=(
  'ops_[A-Za-z0-9._-]{20,}'              # 1Password service account tokens
  'sk-ant-[A-Za-z0-9_-]{20,}'            # Anthropic API keys
  'sk-[A-Za-z0-9]{20,}'                  # OpenAI-style keys
  'AIza[A-Za-z0-9_-]{20,}'               # Google API keys
  'gho_[A-Za-z0-9]{20,}'                 # GitHub OAuth tokens
  'ghp_[A-Za-z0-9]{20,}'                 # GitHub PATs
  'hf_[A-Za-z0-9]{20,}'                  # Hugging Face tokens
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'   # Any private key
  '"refresh_token"\s*:\s*"[^"]{20,}"'    # OAuth refresh tokens in JSON
  '"client_secret"\s*:\s*"[^"]{20,}"'    # Google OAuth client secrets
)

status=0
for pattern in "${patterns[@]}"; do
  if git diff --cached -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -En -e "$pattern" >/dev/null; then
    echo "pre-commit: staged change matches secret pattern: $pattern" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit blocked. Move the secret to a gitignored .env and reference it." >&2
fi
exit "$status"
